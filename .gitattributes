# Keep this file on LF so Windows checkouts do not churn the rules themselves.
.gitattributes         text eol=lf
.gitignore             text eol=lf

# Other text
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.py   text eol=lf

# Binary
*.png binary
*.jpg binary
*.gif binary
